# OliTechs PMS + POS — environment variables
#
# The platform-admin layer (owner login, property approval, package
# assignment, tenant isolation) is backed by Supabase. Create a project at
# supabase.com, run supabase/migrations/0001_platform_admin.sql in its SQL
# editor, then fill these in from Project Settings -> API:

VITE_SUPABASE_URL=https://mszogmazldxjsiytrlxr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1zem9nbWF6bGR4anNpeXRybHhyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyMjQ5ODEsImV4cCI6MjEwMzgwMDk4MX0.dodTPXLxvvhYsCMGnPJQ36uKN65q26b5qZqYYTA-3vo

# The anon key is safe to expose in frontend code by design — Postgres
# Row Level Security (see the migration) is what actually decides what
# each signed-in user can read or write, not this key.
#
# POS/PMS operational data (rooms, reservations, orders, etc.) still runs
# on the local in-memory stores (src/data/*Store.jsx) pending Phase 2 of
# the platform-admin build — see supabase/migrations/README.md.

# Optional additive Back Office feature flags (default: off)
# VITE_FF_BACKOFFICE=true
# VITE_FF_PRINTER_GROUP_ROUTING=true
# VITE_FF_BACKOFFICE_PHASE2=true
